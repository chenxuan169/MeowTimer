<Window x:Class="MeowTimer.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注统计" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="460" Height="540" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" UseLayoutRounding="True">

    <Grid Margin="16">
        <Border CornerRadius="22" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.24" Color="#6B4A5A" />
            </Border.Effect>

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                            <Canvas Width="64" Height="64">
                                <Path Fill="#FFF2809F" Data="M 13,27 L 18,7 L 32,20 Z" />
                                <Path Fill="#FFF2809F" Data="M 51,27 L 46,7 L 32,20 Z" />
                                <Ellipse Canvas.Left="10" Canvas.Top="19" Width="44" Height="38" Fill="#FFF2809F" />
                                <Ellipse Canvas.Left="22" Canvas.Top="31" Width="5" Height="7" Fill="White" />
                                <Ellipse Canvas.Left="37" Canvas.Top="31" Width="5" Height="7" Fill="White" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TitleText" Text="专注统计" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                                   FontFamily="{StaticResource UiFont}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="✕" FontSize="12"
                            HorizontalAlignment="Right" Padding="10,4" Click="OnClose" />
                </Grid>

                <!-- 今日数据 -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                    <Border Background="#FFFFF1F7" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="TodayPomo" Text="0" FontSize="26" TextTrimming="CharacterEllipsis" FontWeight="Bold"
                                       Foreground="#FFE85A87" FontFamily="{StaticResource UiFont}" />
                            <TextBlock x:Name="TodayPomoLabel" Text="今日番茄" FontSize="11.5"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                       FontFamily="{StaticResource UiFont}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFF1F7" CornerRadius="14" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock x:Name="TodayFocus" Text="0m" FontSize="26" TextTrimming="CharacterEllipsis" FontWeight="Bold"
                                       Foreground="#FFE85A87" FontFamily="{StaticResource UiFont}" />
                            <TextBlock x:Name="TodayFocusLabel" Text="今日专注" FontSize="11.5"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                       FontFamily="{StaticResource UiFont}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFF1F7" CornerRadius="14" Padding="14,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalFocus" Text="0h" FontSize="26" TextTrimming="CharacterEllipsis" FontWeight="Bold"
                                       Foreground="#FFE85A87" FontFamily="{StaticResource UiFont}" />
                            <TextBlock x:Name="TotalFocusLabel" Text="累计专注" FontSize="11.5"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                       FontFamily="{StaticResource UiFont}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 趋势标题 -->
                <TextBlock x:Name="TrendLabel" Grid.Row="2" Text="近 7 天专注（分钟）" FontSize="12"
                           FontWeight="SemiBold" Foreground="#C0899F" Margin="2,0,0,8"
                           FontFamily="{StaticResource UiFont}" />

                <!-- 柱状图 -->
                <Border Grid.Row="3" Background="White" CornerRadius="16" BorderBrush="#F7EBF1"
                        BorderThickness="1" Padding="14,16,14,10">
                    <Grid>
                        <Grid x:Name="ChartGrid" VerticalAlignment="Bottom" MinHeight="200" />
                        <TextBlock x:Name="EmptyText" Text="还没有记录，先去专注一下吧～"
                                   FontSize="12.5" Foreground="#C6B2BE" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   FontFamily="{StaticResource UiFont}" />
                    </Grid>
                </Border>

                <Button x:Name="CloseBtn" Grid.Row="4" Content="关闭" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
