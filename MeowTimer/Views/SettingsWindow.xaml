<Window x:Class="MeowTimer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="520" Height="690" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnWindowDragOver" DragLeave="OnWindowDragLeave" Drop="OnWindowDrop">

    <Window.Resources>
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="3,0,0,7" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <Style x:Key="RowCheck" TargetType="CheckBox" BasedOn="{StaticResource MeowCheck}">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="22" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="WinShadow" BlurRadius="30" ShadowDepth="7" Opacity="0.20" Color="#6B4A5A" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== 标题栏 ===== -->
                <Grid Grid.Row="0" Margin="24,16,16,8" MouseLeftButtonDown="OnDragArea" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                            <Canvas Width="64" Height="64">
                                <Path Fill="#FFF2809F" Data="M 13,27 L 18,7 L 32,20 Z" />
                                <Path Fill="#FFF2809F" Data="M 51,27 L 46,7 L 32,20 Z" />
                                <Ellipse Canvas.Left="10" Canvas.Top="19" Width="44" Height="38" Fill="#FFF2809F" />
                                <Ellipse Canvas.Left="22" Canvas.Top="31" Width="5" Height="7" Fill="White" />
                                <Ellipse Canvas.Left="37" Canvas.Top="31" Width="5" Height="7" Fill="White" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HeaderText" Text="设置" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"
                                   FontFamily="{StaticResource UiFont}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="✕" FontSize="12"
                            HorizontalAlignment="Right" Padding="10,4" Click="OnCancel" />
                </Grid>

                <!-- ===== 内容 ===== -->
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="24,2,16,2">
                    <StackPanel>

                        <!-- 外观 -->
                        <TextBlock x:Name="SecAppearance" Text="外观" Style="{StaticResource SecTitle}" />

                        <!-- 实时预览 -->
                        <Border Height="106" CornerRadius="14" Margin="0,0,0,14" ClipToBounds="True"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="PreviewLabel" Text="预览" FontSize="10" Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,7,11,0" FontFamily="{StaticResource UiFont}" />

                                <Border x:Name="PreviewCard" CornerRadius="20" Padding="15,11,19,12"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="90">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="PreviewShadow" BlurRadius="18" ShadowDepth="3"
                                                          Opacity="0.28" Color="#B34768" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox x:Name="PreviewCat" Width="26" Height="26" Margin="0,1,9,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="64" Height="66">
                                                <Path Fill="#FFFFFFFF" Data="M 13,27 L 18,7 L 32,20 Z" />
                                                <Path Fill="#FFFFFFFF" Data="M 51,27 L 46,7 L 32,20 Z" />
                                                <Ellipse Canvas.Left="10" Canvas.Top="19" Width="44" Height="38" Fill="#FFFFFFFF" />
                                                <Ellipse Canvas.Left="15" Canvas.Top="41" Width="9" Height="5.5" Fill="#40FF9EC0" />
                                                <Ellipse Canvas.Left="40" Canvas.Top="41" Width="9" Height="5.5" Fill="#40FF9EC0" />
                                                <Ellipse Canvas.Left="21.5" Canvas.Top="30" Width="5.5" Height="8" Fill="#FF5C4A56" />
                                                <Ellipse Canvas.Left="37" Canvas.Top="30" Width="5.5" Height="8" Fill="#FF5C4A56" />
                                                <Path Fill="#FFFF9EC0" Data="M 29.6,40 L 34.4,40 L 32,42.8 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PreviewTime" Text="25:00" FontSize="21" FontWeight="Bold"
                                                       Foreground="White" FontFamily="{StaticResource UiFont}" />
                                            <Border x:Name="PreviewBar" Height="3" CornerRadius="1.5" Margin="1,5,0,0"
                                                    MinWidth="56" Background="#33FFFFFF">
                                                <Border x:Name="PreviewBarFill" Width="34" Height="3" CornerRadius="1.5"
                                                        HorizontalAlignment="Left" Background="White" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblTheme" Text="配色主题" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource MeowCombo}"
                                              DisplayMemberPath="Display" SelectionChanged="OnThemeChanged" />
                                </Grid>

                                <Border Height="10" CornerRadius="5" Margin="0,2,0,4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="PrevFrom" Color="#FF6F9C" Offset="0" />
                                            <GradientStop x:Name="PrevTo" Color="#FFAFC5" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblBgStyle" Text="背景样式" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="BgStyleCombo" Grid.Column="1" Style="{StaticResource MeowCombo}"
                                              SelectionChanged="OnBgStyleChanged" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblBgColor" Text="背景颜色" Style="{StaticResource RowLabel}" />
                                    <WrapPanel x:Name="ColorPalette" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblTextColor" Text="文字颜色" Style="{StaticResource RowLabel}" />
                                    <WrapPanel x:Name="TextColorPalette" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblFontSize" Text="字号" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="FontSizeBox" Grid.Column="1" Text="46" Width="60" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="3"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly"
                                             TextChanged="OnNumberBoxChanged" />
                                    <TextBlock x:Name="LblFontPx" Grid.Column="2" Text="px" Style="{StaticResource RowLabel}"
                                               Margin="7,0,0,0" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblFont" Text="字体" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource MeowCombo}"
                                              SelectionChanged="OnFontChanged" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblOpacity" Text="背景不透明度" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="OpacityBox" Grid.Column="1" Text="62" Width="60" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="3"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly"
                                             TextChanged="OnNumberBoxChanged" />
                                    <TextBlock x:Name="LblOpacityPct" Grid.Column="2" Text="%" Style="{StaticResource RowLabel}"
                                               Margin="7,0,0,0" />
                                </Grid>

                                <CheckBox x:Name="ShowCatCheck" Content="显示猫咪" Style="{StaticResource RowCheck}"
                                          Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                <CheckBox x:Name="ShowProgressCheck" Content="显示进度条" Style="{StaticResource RowCheck}"
                                          Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                <CheckBox x:Name="ShowStatusCheck" Content="显示状态文字" Style="{StaticResource RowCheck}"
                                          Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                                <CheckBox x:Name="TopmostCheck" Content="窗口置顶" Style="{StaticResource RowCheck}" />
                                <CheckBox x:Name="LockCheck" Content="锁定窗口位置" Style="{StaticResource RowCheck}" />
                            </StackPanel>
                        </Border>

                        <!-- 计时 -->
                        <TextBlock x:Name="SecTimer" Text="计时" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblDefaultMin" Text="默认倒计时" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="DefaultHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblHourUnit" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="DefaultMinBox" Grid.Column="3" Text="25" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0"
                                             PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblMinUnit" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="DefaultSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0"
                                             PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblSecUnit" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <CheckBox x:Name="FlashCheck" Content="结束时闪烁" Style="{StaticResource RowCheck}" />
                                <CheckBox x:Name="LaunchStartCheck" Content="启动后自动开始倒计时" Style="{StaticResource RowCheck}" />
                            </StackPanel>
                        </Border>

                        <!-- 番茄钟 -->
                        <TextBlock x:Name="SecPomodoro" Text="番茄钟" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblWork" Text="工作时长" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="WorkHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblWorkHour" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="WorkMinBox" Grid.Column="3" Text="9" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblWorkMin" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="WorkSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblWorkSec" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblShort" Text="短休息" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="ShortHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblShortHour" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="ShortMinBox" Grid.Column="3" Text="7" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblShortMin" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="ShortSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblShortSec" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblLong" Text="长休息" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="LongHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblLongHour" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="LongMinBox" Grid.Column="3" Text="26" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblLongMin" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="LongSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblLongSec" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblRounds" Text="长休息前番茄数" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="RoundsBox" Grid.Column="1" Text="4" Width="58" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblRoundsUnit" Grid.Column="2" Text="个" Style="{StaticResource RowLabel}" Margin="7,0,0,0" />
                                </Grid>
                                <CheckBox x:Name="AutoNextCheck" Content="自动进入下一阶段" Style="{StaticResource RowCheck}" />
                            </StackPanel>
                        </Border>

                        <!-- 专注 · 休息循环 -->
                        <TextBlock x:Name="SecCycle" Text="专注 · 休息" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblFocusLen" Text="专注时长" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="FocusHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblFocusHour" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="FocusMinBox" Grid.Column="3" Text="45" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblFocusMin" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="FocusSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblFocusSec" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblBreakLen" Text="休息时长" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="BreakHourBox" Grid.Column="1" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblBreakHour" Grid.Column="2" Text="时" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="BreakMinBox" Grid.Column="3" Text="10" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblBreakMin" Grid.Column="4" Text="分" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                    <TextBox x:Name="BreakSecBox" Grid.Column="5" Text="0" Width="50" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" Margin="10,0,0,0" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblBreakSec" Grid.Column="6" Text="秒" Style="{StaticResource RowLabel}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblCycleRounds" Text="循环轮数" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="CycleRoundsBox" Grid.Column="1" Text="0" Width="58" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="2"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblCycleRoundsUnit" Grid.Column="2" Text="轮" Style="{StaticResource RowLabel}" Margin="7,0,0,0" />
                                </Grid>
                                <CheckBox x:Name="CycleAutoCheck" Content="自动开始下一阶段" Style="{StaticResource RowCheck}" />
                            </StackPanel>
                        </Border>

                        <!-- 提醒 -->
                        <TextBlock x:Name="SecAlert" Text="提醒" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <CheckBox x:Name="SoundCheck" Content="开启提示音" Style="{StaticResource RowCheck}" />

                                <!-- 音效目录 -->
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblSoundDir" Text="音效目录" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="SoundDirText" Grid.Column="1" Text="" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                               FontFamily="{StaticResource UiFont}" />
                                    <Button x:Name="ChangeDirBtn" Grid.Column="2" Content="更改"
                                            Style="{StaticResource GhostButton}" Padding="9,5" Click="OnChangeSoundDir" />
                                    <Button x:Name="OpenDirBtn" Grid.Column="3" Content="打开"
                                            Style="{StaticResource GhostButton}" Padding="9,5" Margin="4,0,0,0"
                                            Click="OnOpenSoundDir" />
                                    <Button x:Name="ResetDirBtn" Grid.Column="4" Content="↺"
                                            Style="{StaticResource GhostButton}" Padding="9,5" Margin="4,0,0,0"
                                            ToolTip="恢复默认目录" Click="OnResetSoundDir" />
                                </Grid>

                                <!-- 拖拽区 -->
                                <Border x:Name="DropZone" CornerRadius="10" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}"
                                        Padding="10,9" Margin="0,6,0,2">
                                    <TextBlock x:Name="DropHint" Text="把 mp3 / wav 文件拖到这里，自动加入音效库"
                                               FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center"
                                               TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" />
                                </Border>

                                <!-- 三个事件音效 -->
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblSoundFinish" Text="专注结束" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="SoundFinishCombo" Grid.Column="1" Style="{StaticResource MeowCombo}" />
                                    <Button Grid.Column="2" Content="▶" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="7,0,0,0" Click="OnPreviewFinish" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblSoundBreak" Text="休息结束" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="SoundBreakCombo" Grid.Column="1" Style="{StaticResource MeowCombo}" />
                                    <Button Grid.Column="2" Content="▶" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="7,0,0,0" Click="OnPreviewBreak" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblSoundPre" Text="提前提醒" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="SoundPreCombo" Grid.Column="1" Style="{StaticResource MeowCombo}" />
                                    <Button Grid.Column="2" Content="▶" Style="{StaticResource GhostButton}"
                                            Padding="10,4" Margin="7,0,0,0" Click="OnPreviewPre" />
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblVolume" Text="音量" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="VolumeBox" Grid.Column="1" Text="80" Width="58" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="3"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblVolumePct" Grid.Column="2" Text="%" Style="{StaticResource RowLabel}"
                                               Margin="7,0,0,0" />
                                </Grid>
                                <CheckBox x:Name="NotifyCheck" Content="系统通知气泡" Style="{StaticResource RowCheck}" />
                                <CheckBox x:Name="PreAlertCheck" Content="提前提醒" Style="{StaticResource RowCheck}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPreSeconds" Text="提前几秒" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="PreSecBox" Grid.Column="1" Text="60" Width="58" Height="34"
                                             Style="{StaticResource MeowTextBox}" TextAlignment="Center" MaxLength="3"
                                             VerticalContentAlignment="Center" PreviewTextInput="OnNumberOnly" />
                                    <TextBlock x:Name="LblPreSecUnit" Grid.Column="2" Text="秒" Style="{StaticResource RowLabel}"
                                               Margin="7,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 系统 -->
                        <TextBlock x:Name="SecSystem" Text="系统" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblLang" Text="界面语言" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="LangCombo" Grid.Column="1" Style="{StaticResource MeowCombo}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblTrayMode" Text="托盘图标显示" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="TrayModeCombo" Grid.Column="1" Style="{StaticResource MeowCombo}" />
                                </Grid>
                                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Style="{StaticResource RowCheck}" />
                                <CheckBox x:Name="StartMinCheck" Content="启动后最小化到托盘" Style="{StaticResource RowCheck}" />
                            </StackPanel>
                        </Border>

                        <!-- 快捷键 -->
                        <TextBlock x:Name="SecHotkey" Text="全局快捷键" Style="{StaticResource SecTitle}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkPause" Text="开始 / 暂停" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkPause" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkReset" Text="重置" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkReset" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkTimer" Text="设置倒计时" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkTimer" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkClock" Text="显示时钟" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkClock" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkShow" Text="显示 / 隐藏" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkShow" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkTop" Text="窗口置顶" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkTop" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkPomo" Text="番茄钟" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkPomo" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHkCycle" Text="专注 · 休息" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="HkCycle" Grid.Column="1" Style="{StaticResource MeowTextBox}" />
                                </Grid>
                                <TextBlock x:Name="HkHint" Text="格式：Ctrl+Alt+P；留空表示不启用" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="3,4,0,2" FontFamily="{StaticResource UiFont}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="VersionText" Text="喵时 MeowTimer v1.0" FontSize="11" Foreground="#C6B2BE"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="{StaticResource UiFont}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 底部按钮 ===== -->
                <Border Grid.Row="2" BorderBrush="#F5E8EF" BorderThickness="0,1,0,0" Padding="24,12,24,16">
                    <Grid>
                        <Button x:Name="DefaultBtn" Content="恢复默认" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Padding="12,7" Click="OnRestoreDefaults" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Click="OnCancel" />
                            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
