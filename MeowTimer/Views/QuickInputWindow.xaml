<Window x:Class="MeowTimer.Views.QuickInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置倒计时" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="392" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" UseLayoutRounding="True">

    <Grid Margin="16">
        <Border CornerRadius="20" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.22" Color="#6B4A5A" />
            </Border.Effect>

            <StackPanel Margin="24,18,24,18">
                <Grid Background="Transparent" MouseLeftButtonDown="OnDragArea">
                    <TextBlock x:Name="TitleText" Text="要专注多久？" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" />
                    <Button Style="{StaticResource GhostButton}" Content="✕" FontSize="12"
                            HorizontalAlignment="Right" Padding="9,3" Click="OnCancel" />
                </Grid>

                <!-- 时 / 分 / 秒 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBox x:Name="HourBox" Text="0" Height="58" FontSize="26" FontWeight="Bold"
                                 TextAlignment="Center" MaxLength="2"
                                 Style="{StaticResource MeowTextBox}" VerticalContentAlignment="Center"
                                 PreviewTextInput="OnNumberInput" GotFocus="OnBoxFocus" />
                        <TextBlock x:Name="UnitHour" Text="时" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="{StaticResource UiFont}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="MinBox" Text="25" Height="58" FontSize="26" FontWeight="Bold"
                                 TextAlignment="Center" MaxLength="2"
                                 Style="{StaticResource MeowTextBox}" VerticalContentAlignment="Center"
                                 PreviewTextInput="OnNumberInput" GotFocus="OnBoxFocus" />
                        <TextBlock x:Name="UnitMin" Text="分" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="{StaticResource UiFont}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBox x:Name="SecBox" Text="0" Height="58" FontSize="26" FontWeight="Bold"
                                 TextAlignment="Center" MaxLength="2"
                                 Style="{StaticResource MeowTextBox}" VerticalContentAlignment="Center"
                                 PreviewTextInput="OnNumberInput" GotFocus="OnBoxFocus" />
                        <TextBlock x:Name="UnitSec" Text="秒" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="{StaticResource UiFont}" />
                    </StackPanel>
                </Grid>

                <!-- 快捷预设 -->
                <WrapPanel x:Name="PresetPanel" Margin="0,16,0,0">
                    <Button Content="5 分" Tag="300" Style="{StaticResource GhostButton}" Padding="10,5"
                            Margin="0,0,6,0" Click="OnPreset" />
                    <Button Content="15 分" Tag="900" Style="{StaticResource GhostButton}" Padding="10,5"
                            Margin="0,0,6,0" Click="OnPreset" />
                    <Button Content="25 分" Tag="1500" Style="{StaticResource GhostButton}" Padding="10,5"
                            Margin="0,0,6,0" Click="OnPreset" />
                    <Button Content="45 分" Tag="2700" Style="{StaticResource GhostButton}" Padding="10,5"
                            Margin="0,0,6,0" Click="OnPreset" />
                    <Button Content="1 时" Tag="3600" Style="{StaticResource GhostButton}" Padding="10,5"
                            Click="OnPreset" />
                </WrapPanel>

                <TextBlock x:Name="TotalText" Text="= 25 分 0 秒" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" Margin="2,12,0,0"
                           FontFamily="{StaticResource UiFont}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}"
                            Click="OnCancel" Margin="0,0,8,0" />
                    <Button x:Name="StartBtn" Content="开始" Style="{StaticResource PrimaryButton}"
                            Click="OnStart" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
