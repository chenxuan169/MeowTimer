<Window x:Class="MeowTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="喵时 MeowTimer"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid" Margin="22">
        <Border x:Name="Card" CornerRadius="26" Padding="20,14,26,16" MinWidth="120">
            <Border.Effect>
                <DropShadowEffect x:Name="CardGlow" BlurRadius="30" ShadowDepth="4" Opacity="0.32" Color="#B34768" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ===== 猫咪 ===== -->
                <Viewbox x:Name="CatHost" Width="42" Height="42" Margin="0,1,13,0" VerticalAlignment="Center">
                    <Canvas Width="64" Height="66">
                        <!-- 耳朵 -->
                        <Path Fill="#FFFFFFFF" Data="M 13,27 L 18,7 L 32,20 Z" />
                        <Path Fill="#FFFFFFFF" Data="M 51,27 L 46,7 L 32,20 Z" />
                        <Path Fill="#FFFFC2D8" Data="M 17.5,24 L 20.5,13 L 27,20.5 Z" />
                        <Path Fill="#FFFFC2D8" Data="M 46.5,24 L 43.5,13 L 37,20.5 Z" />
                        <!-- 头 -->
                        <Ellipse Canvas.Left="10" Canvas.Top="19" Width="44" Height="38" Fill="#FFFFFFFF" />
                        <!-- 腮红 -->
                        <Ellipse x:Name="CheekLeft" Canvas.Left="15" Canvas.Top="41" Width="9" Height="5.5" Fill="#40FF9EC0" />
                        <Ellipse x:Name="CheekRight" Canvas.Left="40" Canvas.Top="41" Width="9" Height="5.5" Fill="#40FF9EC0" />
                        <!-- 眼睛 -->
                        <Ellipse x:Name="EyeLeft" Canvas.Left="21.5" Canvas.Top="30" Width="5.5" Height="8"
                                 Fill="#FF5C4A56" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="EyeLeftScale" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="EyeRight" Canvas.Left="37" Canvas.Top="30" Width="5.5" Height="8"
                                 Fill="#FF5C4A56" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="EyeRightScale" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- 鼻子 -->
                        <Path Fill="#FFFF9EC0" Data="M 29.6,40 L 34.4,40 L 32,42.8 Z" />
                        <!-- 胡须 -->
                        <Path Stroke="#4DFF9EC0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,37 L 14,39 M 5,42 L 14,41 M 59,37 L 50,39 M 59,42 L 50,41" />
                    </Canvas>
                </Viewbox>

                <!-- ===== 时间 ===== -->
                <Grid x:Name="TextHost" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TimeText" Grid.Row="0" Text="25:00"
                               FontFamily="Microsoft YaHei UI" FontSize="46" FontWeight="Bold"
                               Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="TextGlow" BlurRadius="22" ShadowDepth="0"
                                              Opacity="0.55" Color="White" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="点一下开始"
                               FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Medium"
                               Margin="2,3,0,0" Opacity="0.92" />

                    <Border x:Name="ProgressBg" Grid.Row="2" Height="4" CornerRadius="2"
                            Margin="1,7,0,0" Background="#33FFFFFF" ClipToBounds="True">
                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                                HorizontalAlignment="Left" Width="0" Background="#FFFFFFFF" />
                    </Border>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 编辑模式提示框 -->
        <Rectangle x:Name="EditFrame" RadiusX="31" RadiusY="31"
                   Stroke="White" StrokeThickness="1.6" StrokeDashArray="5 4"
                   Opacity="0.95" Margin="-5" Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- 右下角缩放手柄（编辑模式出现） -->
        <Border x:Name="ResizeHandle" Width="22" Height="22" CornerRadius="11"
                Background="White" Cursor="SizeNWSE"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-9,-9" Visibility="Collapsed"
                ToolTip="拖动调整大小"
                MouseLeftButtonDown="OnResizeStart"
                MouseMove="OnResizeMove"
                MouseLeftButtonUp="OnResizeEnd">
            <Border.Effect>
                <DropShadowEffect BlurRadius="9" ShadowDepth="1" Opacity="0.35" Color="#B34768" />
            </Border.Effect>
            <Path Data="M 3,9 L 9,3 M 6,9 L 9,6" Stroke="#F2558B" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
